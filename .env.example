# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Database ---
POSTGRES_USER=extraction
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=extraction

# --- App secrets ---
# Session signing key. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Fernet key used to encrypt uploaded files at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILE_ENCRYPTION_KEY=change-me

# --- Admin login (single admin for now) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# --- Public base URL (used to build client links) ---
# In production set this to your https domain, e.g. https://intake.yourdomain.com
BASE_URL=http://localhost:8000

# Domain Caddy serves HTTPS for (production overlay only), e.g. intake.yourdomain.com
SITE_ADDRESS=intake.yourdomain.com

# Where to expose the app:
#   BIND_HOST=127.0.0.1 -> only a reverse proxy on the server reaches it (default)
#   BIND_HOST=0.0.0.0   -> reachable directly at http://<server-ip>:APP_PORT
BIND_HOST=127.0.0.1
# Host port the app binds on (pick one not already in use).
APP_PORT=8011

# Max upload size per file, in megabytes.
MAX_UPLOAD_MB=15

# Default number of days an intake link stays valid (0 = never expires).
# Can be overridden per-link when generating it in the dashboard.
LINK_EXPIRY_DAYS=7

# --- Document extraction engine ---
# Leave LLM_PROVIDER blank to use offline Tesseract only.
# Set to "gemini" and provide a key to use Google Gemini vision (more accurate;
# document images are sent to Google's API). Falls back to Tesseract on failure.
LLM_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
